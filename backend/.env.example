# Agritech Advisory Assistant - Backend Environment Variables
PORT=8000
DATABASE_URL=sqlite:///./agritech.db

# 1. Mandi Prices: data.gov.in Agmarknet API
# Register for free at https://data.gov.in/ to get an API key.
# If omitted or empty, the system automatically uses the curated fallback dataset.
DATA_GOV_API_KEY=

# 2. OpenWeatherMap Free Forecast API
# Sign up free at https://openweathermap.org/api (Current & 5-day forecast)
# If omitted or empty, the system uses high-fidelity regional weather simulation.
OPENWEATHER_API_KEY=

# 3. Google Gemini Free Tier API (google-genai SDK)
# Get free key from https://aistudio.google.com/
# If omitted or empty, the assistant uses built-in high accuracy multilingual rule templates.
GEMINI_API_KEY=

# 4. BHASHINI ULCA API (MeitY Government of India)
# Register at https://bhashini.gov.in/ulca
# If omitted or empty, instant zero-key fallback with browser-native Web Speech API is used.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
